meta {
  name: Get Tasks
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/tasks
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a list of tasks", function () {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody()[0]).to.have.property("title");
  });
}
